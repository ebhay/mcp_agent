# OpenAI (ChatGPT API). Create a key at platform.openai.com.
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# SQL database. SQLite is a local file and needs no install.
# Other examples:
#   postgresql+psycopg://user:password@localhost:5432/trainmate
#   mysql+pymysql://user:password@localhost:3306/mailagent   <- MySQL Workbench / local MySQL 8
DATABASE_URL=sqlite:///./app.db

# Coach agent (TrainMate hosted API + this app's mail API)
TRAINMATE_BASE_URL=https://trainmate-o6tv.onrender.com
APP_BASE_URL=http://localhost:8000
BATCH_MATCH_THRESHOLD=0.35

# Demo accounts (passwords are required; choose your own)
COACH_LOGIN_ID=coach01
COACH_PASSWORD=change-me
TRAINER_LOGIN_ID=trainer01
TRAINER_PASSWORD=change-me
ADMIN_LOGIN_ID=admin01
ADMIN_PASSWORD=change-me
