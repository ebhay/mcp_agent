# LLM provider. Blank OPENAI_BASE_URL = OpenAI.
# For Gemini (OpenAI-compatible endpoint):
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Database backend: "sql" or "mongo"
DB_BACKEND=mongo
DATABASE_URL=sqlite:///./app.db

# MongoDB (used when DB_BACKEND=mongo)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/
MONGO_DB_NAME=appdb

# Coach agent (TrainMate hosted API + this app's mail API)
TRAINMATE_BASE_URL=https://trainmate-o6tv.onrender.com
APP_BASE_URL=http://localhost:8000
BATCH_MATCH_THRESHOLD=0.35

# Demo accounts (passwords are required; choose your own)
COACH_LOGIN_ID=coach01
COACH_PASSWORD=change-me
TRAINER_LOGIN_ID=trainer01
TRAINER_PASSWORD=change-me
ADMIN_LOGIN_ID=admin01
ADMIN_PASSWORD=change-me
